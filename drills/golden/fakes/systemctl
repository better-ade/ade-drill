#!/bin/bash
# A stand-in for systemd's user manager: units are read from the drill's own home, never from this machine's systemd.
#   systemctl --user daemon-reload | enable --now <unit> | disable --now <unit> | is-active <unit>
# An enabled .service is started once (its ExecStart, in its WorkingDirectory, with no terminal); a .timer is only
# recorded. The service gets the drill's stand-ins first on PATH, then the unit's own PATH, then the drill's PATH.
set -u; S="${DRILL_SYSTEMD:?systemctl stand-in: DRILL_SYSTEMD is not set}"; mkdir -p "$S"
U="${AGENT_SYSTEMD_USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
[ "${1:-}" = --user ] || { echo "systemctl stand-in: only --user" >&2; exit 1; }; shift
printf '%s\n' "$*" >> "$S/systemctl.log"
verb="${1:-}"; [ $# -gt 0 ] && shift; [ "${1:-}" = --now ] && shift; unit="${1:-}"
pidfile="$S/unit-$unit.pid"; flag="$S/unit-$unit.enabled"
alive() { local p; p="$(cat "$pidfile" 2>/dev/null)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
case "$verb" in
  daemon-reload) exit 0 ;;
  is-active) [ -n "$unit" ] && alive ;;
  disable) [ -n "$unit" ] || exit 1; if alive; then kill "$(cat "$pidfile")" 2>/dev/null; fi
    : > "$pidfile"; [ ! -f "$flag" ] || mv "$flag" "$S/unit-$unit.disabled"; exit 0 ;;
  enable) [ -n "$unit" ] && [ -f "$U/$unit" ] || { echo "Failed to enable unit: Unit file $unit does not exist." >&2; exit 1; }
    : > "$flag"; case "$unit" in *.timer) exit 0 ;; esac; alive && exit 0
    cmd="$(sed -n 's/^ExecStart=//p' "$U/$unit" | head -1)"; wd="$(sed -n 's/^WorkingDirectory=//p' "$U/$unit" | head -1)"
    upath="$(sed -n 's/^Environment="PATH=\(.*\)"$/\1/p' "$U/$unit" | head -1)"
    # as systemd starts a service: in a session of its own, with no terminal (the caller's terminal closing must not
    # end it), every stream to its log (so nothing of it holds the caller's output open)
    ( cd "$wd" && PATH="${DRILL_FAKES:?}:${upath:+$upath:}$PATH" TERM=xterm-256color exec nohup python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' bash -c "exec $cmd" ) \
      < /dev/null >> "$S/unit-$unit.log" 2>&1 &
    echo $! > "$pidfile"
    exit 0 ;;
  *) echo "systemctl stand-in: not a call the drill knows: $verb $*" >&2; exit 1 ;;
esac
